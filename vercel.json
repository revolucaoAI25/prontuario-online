{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/cron/disparos", "schedule": "0 12 * * *" }],
  "functions": {
    "api/cron/disparos.js": { "maxDuration": 60 },
    "api/cron/faltas.js": { "maxDuration": 60 },
    "api/cron/campanhas.js": { "maxDuration": 60 },
    "api/whatsapp/[acao].js": { "maxDuration": 60 },
    "api/webhooks/evolution.js": { "maxDuration": 60 },
    "api/cron/whatsapp.js": { "maxDuration": 60 }
  }
}
