# ---- App (Vercel → Settings → Environment Variables; localmente em .env.local)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Funções /api (somente no servidor)
# Supabase → Connect → Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Chave da API de agendamento (cabeçalho x-api-key). Gere com: openssl rand -hex 32
CLINIC_API_KEY=
# A Vercel envia este valor no cron diário
CRON_SECRET=
# Vai na URL do webhook configurado na Evolution API
EVOLUTION_WEBHOOK_SECRET=
# Opcional: assina os webhooks de lembrete/aniversário (cabeçalho x-clinica-assinatura)
WEBHOOK_SIGNING_SECRET=
# Servidor Evolution API (pode ser o mesmo de outro projeto; a instância é própria da clínica)
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=clinica-rezeck
# Opcional: endereço público do sistema (senão é deduzido da requisição)
PUBLIC_APP_URL=

# ---- Migração do FastClinic (scripts/migrate-fastclinic.mjs)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DB=clinica
